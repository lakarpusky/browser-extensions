{
  "manifest_version": 3,
  "name": "Open in IINA",
  "version": "1.1.0",
  "description": "Opens the current YouTube, Twitter/X, or Twitch video in IINA.",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open in IINA",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": ["activeTab", "tabs"],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+I",
        "mac": "Alt+I"
      },
      "description": "Open current video in IINA"
    }
  }
}